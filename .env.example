# Firebase web app configuration.
#
# These values are read at BUILD time by Vite, so they must be set in the
# Render dashboard under Environment Variables and the site must be rebuilt
# after changing them. If none are set the app falls back to the
# firebase-applet-config.json file in the project root.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. The Realtime Database URL. Leave blank to use
# https://<projectId>-default-rtdb.firebaseio.com, which is what the Firebase
# console creates by default. Only set this if you created the database under a
# custom name.
VITE_FIREBASE_DATABASE_URL=

# Optional. Only needed for Google Sign-In with a custom OAuth client.
# Leave blank to use the project's default web OAuth client.
VITE_FIREBASE_OAUTH_CLIENT_ID=
